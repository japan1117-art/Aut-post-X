# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase (server-side service role only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X Developer App: OAuth 1.0a user context with Read and Write permission
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Endpoint protection
CRON_SECRET=
ADMIN_SECRET=

# Safety: true never sends anything to X
DRY_RUN=true
